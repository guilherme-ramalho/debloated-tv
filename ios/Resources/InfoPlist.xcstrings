    "NSLocalNetworkUsageDescription" : {
      "comment" : "Shown when iOS asks for Local Network access.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindet sich direkt mit deinem Fernseher, damit du ihn mit diesem iPhone steuern kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connects directly to your TV so you can control it from this iPhone."
          }
        },
