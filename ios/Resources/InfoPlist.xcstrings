    "NSLocalNetworkUsageDescription" : {
      "comment" : "Shown when iOS asks for Local Network access.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindet sich direkt mit deinem Fernseher, damit du ihn mit diesem iPhone steuern kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connects directly to your TV so you can control it from this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conecta directamente a tu televisor para que puedas controlarlo desde este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecte directement à votre téléviseur pour que vous puissiez le contrôler depuis cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si collega direttamente al tuo televisore per controllarlo da questo iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta diretamente à sua TV para você controlá-la a partir deste iPhone."
          }
        }
      }
    },
