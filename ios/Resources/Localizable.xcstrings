    "The TV listed no apps, so nothing was changed. Check the connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher hat keine Apps gemeldet, daher wurde nichts geändert. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV no listó ninguna app, así que no se cambió nada. Revisa la conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
