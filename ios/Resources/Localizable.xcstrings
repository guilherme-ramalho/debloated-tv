            "value" : "Tieni almeno un profilo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pelo menos um perfil."
          }
        }
      }
    },
    "Keep switched on = stays enabled. %lld protected system apps are never touched. %lld listed apps are already off or not installed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingeschaltet = bleibt aktiv. %lld geschützte System-Apps werden nie angerührt. %lld gelistete Apps sind schon aus oder nicht installiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep switched on = stays enabled. %1$lld protected system apps are never touched. %2$lld listed apps are already off or not installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado = sigue activa. %lld apps del sistema protegidas nunca se tocan. %lld apps de la lista ya están desactivadas o no instaladas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé = reste actif. %lld apps système protégées ne sont jamais touchées. %lld apps de la liste sont déjà désactivées ou absentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivo = resta attiva. %lld app di sistema protette non vengono mai toccate. %lld app dell'elenco sono già spente o non installate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligado = continua ativo. %lld apps de sistema protegidos nunca são tocados. %lld apps da lista já estão desativados ou não instalados."
          }
        }
      }
    },
