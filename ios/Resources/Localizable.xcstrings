    "192.168.1.20" : {

    },
    "A bit quieter" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas leiser"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco más bajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu moins fort"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un po' più basso"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pouco mais baixo"
          }
        }
      }
    },
    "A different build of this Home screen is already on the TV, signed with another key. Uninstall it on the TV first, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Fernseher ist bereits eine andere Version dieses Startbildschirms, mit einem anderen Schlüssel signiert. Deinstalliere sie zuerst am Fernseher und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay otra versión de esta pantalla de inicio en la TV, firmada con otra clave. Desinstálala en la TV e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre version de cet écran d'accueil est déjà sur la TV, signée avec une autre clé. Désinstallez-la d'abord sur la TV, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla TV c'è già un'altra versione di questa schermata Home, firmata con un'altra chiave. Disinstallala prima dalla TV, poi riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra versão desta tela inicial já está na TV, assinada com outra chave. Desinstale-a na TV e tente de novo."
          }
        }
      }
    },
    "A guided setup to keep your essentials, disable unwanted extras and choose a cleaner Home. No computer needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine geführte Einrichtung: Wichtiges behalten, Unerwünschtes deaktivieren und einen aufgeräumten Startbildschirm wählen. Ohne Computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configuración guiada para conservar lo esencial, desactivar extras no deseados y elegir una pantalla de inicio más limpia. Sin ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une configuration guidée pour garder l'essentiel, désactiver le superflu et choisir un écran d'accueil épuré. Sans ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configurazione guidata per tenere l'essenziale, disattivare gli extra indesiderati e scegliere una schermata Home più pulita. Senza computer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma configuração guiada para manter o essencial, desativar extras indesejados e escolher uma tela inicial mais limpa. Sem computador."
          }
        }
      }
    },
    "A newer TV Home comes with this app. Your layout stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App bringt ein neueres TV Home mit. Dein Layout bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app trae un TV Home más reciente. Tu diseño se mantiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app contient un TV Home plus récent. Votre disposition est conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app include un TV Home più recente. Il tuo layout resta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app traz um TV Home mais novo. Seu layout continua igual."
          }
        }
      }
    },
    "A newer version of the Home screen comes with this app. Your dock, apps, wallpaper and Home settings stay as they are. Takes about a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App bringt eine neuere Version des Startbildschirms mit. Dock, Apps, Hintergrund und Home-Einstellungen bleiben, wie sie sind. Dauert etwa eine Minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app trae una versión más reciente de la pantalla de inicio. El dock, las apps, el fondo y los ajustes de Home se quedan como están. Tarda alrededor de un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app contient une version plus récente de l'écran d'accueil. Le dock, les apps, le fond d'écran et les réglages de Home restent tels quels. Environ une minute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app include una versione più recente della schermata Home. Dock, app, sfondo e impostazioni della Home restano come sono. Ci vuole circa un minuto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app traz uma versão mais nova da tela inicial. Dock, apps, papel de parede e ajustes da Home continuam como estão. Leva cerca de um minuto."
          }
        }
      }
    },
    "A supported TV" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein unterstützter Fernseher"
          }
        },
