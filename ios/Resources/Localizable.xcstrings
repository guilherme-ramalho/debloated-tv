    "Your apps, TV features and Home screen. Every change is reviewed first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Apps, TV-Funktionen und dein Startbildschirm. Jede Änderung wird vorher geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus apps, funciones de la TV y pantalla de inicio. Cada cambio se revisa antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos apps, fonctions TV et écran d'accueil. Chaque changement est vérifié d'abord."
          }
        },
        "it" : {
          "stringUnit" : {
