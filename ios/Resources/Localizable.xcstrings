    "Setup reads the model before changing anything" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einrichtung liest das Modell, bevor sie etwas ändert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración lee el modelo antes de cambiar nada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration lit le modèle avant de modifier quoi que ce soit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configurazione legge il modello prima di cambiare qualcosa"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração lê o modelo antes de alterar qualquer coisa"
          }
        }
      }
    },
    "Setup switches off the bloat your TV ships with and installs a clean Home screen. It checks your model first, nothing is deleted, and you can undo it anytime." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einrichtung schaltet vorinstallierten Ballast ab und installiert einen aufgeräumten Startbildschirm. Sie prüft zuerst dein Modell, löscht nichts, und du kannst alles jederzeit rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración desactiva el bloatware que trae tu TV e instala una pantalla de inicio limpia. Comprueba primero tu modelo, no borra nada y puedes deshacerlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration désactive le superflu fourni avec votre TV et installe un écran d'accueil épuré. Elle vérifie d'abord votre modèle, ne supprime rien, et vous pouvez tout annuler à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configurazione disattiva il superfluo preinstallato sulla TV e installa una schermata Home pulita. Controlla prima il modello, non elimina nulla e puoi annullare quando vuoi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração desativa os excessos que vêm na TV e instala uma tela inicial limpa. Ela verifica seu modelo primeiro, nada é apagado e dá para desfazer quando quiser."
          }
        }
      }
    },
