    "The TV Home screen this app installs and the tested per-TV app lists come from cleanyourtv by Gathin, used under the MIT License." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Startbildschirm, den diese App installiert, und die getesteten Listen pro Modell stammen aus cleanyourtv von Gathin und werden unter der MIT-Lizenz verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla de inicio que esta app instala en la TV y las listas probadas por modelo provienen de cleanyourtv, de Gathin, usados bajo la Licencia MIT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écran d'accueil installé par cette app et les listes testées par modèle proviennent de cleanyourtv, par Gathin, utilisés sous licence MIT."
