        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun accueil par défaut et aucune autre app ne pourrait répondre à Accueil. Installez d'abord le nouvel écran d'accueil."
          }
        },
        "it" : {
          "stringUnit" : {
