    "Nothing after the failed step was changed. You can restore everything this setup changed, or go back and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem fehlgeschlagenen Schritt wurde nichts geändert. Du kannst alles zurücksetzen, was diese Einrichtung geändert hat, oder zurückgehen und es erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se cambió nada después del paso fallido. Puedes restaurar todo lo que cambió esta configuración o volver e intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'a été modifié après l'étape en échec. Vous pouvez restaurer tout ce que cette configuration a changé ou revenir en arrière et réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla è stato cambiato dopo il passaggio fallito. Puoi ripristinare tutto ciò che la configurazione ha cambiato o tornare indietro e riprovare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada depois da etapa que falhou foi alterado. Você pode restaurar tudo o que esta configuração mudou ou voltar e tentar de novo."
          }
        }
      }
    },
