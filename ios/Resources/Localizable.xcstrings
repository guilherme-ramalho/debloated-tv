    "After restarting, Home went to %@ instead of a working Home screen. Restore the TV now, while this phone can still reach it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Neustart ging der Startbildschirm zu %@ statt zu einem funktionierenden Startbildschirm. Stelle den Fernseher jetzt wieder her, solange dieses Telefon ihn noch erreicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras reiniciar, la pantalla de inicio fue a %@ en lugar de a una que funcione. Restaura la TV ahora, mientras este teléfono aún puede conectarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après le redémarrage, l'accueil est allé vers %@ au lieu d'un écran d'accueil qui fonctionne. Restaurez la TV maintenant, tant que ce téléphone peut encore la joindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo il riavvio la Home è andata su %@ invece che su una schermata Home funzionante. Ripristina la TV ora, finché questo telefono può ancora raggiungerla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de reiniciar, a tela inicial foi para %@ em vez de uma que funcione. Restaure a TV agora, enquanto este telefone ainda consegue alcançá-la."
          }
        }
      }
    },
