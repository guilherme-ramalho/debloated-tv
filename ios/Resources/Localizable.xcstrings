    "Input assignments come from your TV. No HDMI port is guessed from the device name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingangszuordnungen kommen von deinem Fernseher. Kein HDMI-Port wird aus dem Gerätenamen erraten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las asignaciones de entrada vienen de tu TV. No se deduce ningún puerto HDMI del nombre del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les attributions d'entrée viennent de votre TV. Aucun port HDMI n'est deviné à partir du nom de l'appareil."
