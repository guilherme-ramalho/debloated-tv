    "Switch off the preinstalled apps your TV runs in the background and get a clean, fast Home screen you edit from this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte die vorinstallierten Apps ab, die dein Fernseher im Hintergrund laufen lässt, und erhalte einen aufgeräumten, schnellen Startbildschirm, den du mit diesem iPhone bearbeitest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva las apps preinstaladas que tu TV ejecuta en segundo plano y consigue una pantalla de inicio limpia y rápida que editas desde este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez les apps préinstallées que votre TV fait tourner en arrière-plan et obtenez un écran d'accueil épuré et rapide, modifiable depuis cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva le app preinstallate che la TV esegue in background e ottieni una schermata Home pulita e veloce, da modificare da questo iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative os apps pré-instalados que a TV roda em segundo plano e tenha uma tela inicial limpa e rápida, editada por este iPhone."
          }
        }
      }
    },
