    "Could not wake the TV. Check Ethernet and enable Network Standby / Quick Start on the TV." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher ließ sich nicht wecken. Prüfe das Netzwerkkabel und aktiviere Netzwerk-Standby / Schnellstart am Fernseher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo encender la TV. Revisa el cable de red y activa el modo de espera en red / Inicio rápido en la TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de réveiller la TV. Vérifiez le câble réseau et activez la veille réseau / le démarrage rapide sur la TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile riattivare la TV. Controlla il cavo di rete e attiva lo standby di rete / avvio rapido sulla TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ligar a TV. Verifique o cabo de rede e ative o modo de espera em rede / Início rápido na TV."
          }
        }
      }
    },
    "Couldn't ask the TV which apps answer Home, and this is a stock launcher." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher konnte nicht gefragt werden, welche Apps auf „Home“ reagieren, und dies ist ein vorinstallierter Launcher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo preguntar a la TV qué apps responden a Inicio, y este es un launcher de fábrica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de demander à la TV quelles apps répondent à Accueil, et c'est un launcher d'origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile chiedere alla TV quali app rispondono a Home, e questo è un launcher di serie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível perguntar à TV quais apps respondem ao Home, e este é um launcher original."
          }
        }
      }
    },
    "Couldn't check which app owns the saved Wi-Fi networks. If the TV uses Ethernet, you can allow it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ließ sich nicht prüfen, welcher App die gespeicherten WLANs gehören. Nutzt der Fernseher ein Netzwerkkabel, kannst du es erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo comprobar qué app es dueña de las redes Wi-Fi guardadas. Si la TV usa cable de red, puedes permitirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de vérifier à quelle app appartiennent les réseaux Wi-Fi enregistrés. Si la TV utilise un câble réseau, vous pouvez l'autoriser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile verificare a quale app appartengono le reti Wi-Fi salvate. Se la TV usa un cavo di rete, puoi consentirlo."
          }
        },
        "pt-BR" : {
