    "The TV couldn't play this video. It may use a format the TV's player doesn't support (often HDR or Dolby Vision from recent iPhones). Photos and other videos still work." : {
      "comment" : "Show on TV (photo library on the TV).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV couldn't play this video. It may use a format the TV's player doesn't support (often HDR or Dolby Vision from recent iPhones). Photos and other videos still work."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher konnte dieses Video nicht abspielen. Vielleicht nutzt es ein Format, das sein Player nicht kann (oft HDR oder Dolby Vision von neueren iPhones). Fotos und andere Videos funktionieren weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tele no pudo reproducir este vídeo. Puede que use un formato que su reproductor no admite (a menudo HDR o Dolby Vision de iPhone recientes). Las fotos y otros vídeos siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV n'a pas pu lire cette vidéo. Elle utilise peut-être un format que son lecteur ne prend pas en charge (souvent le HDR ou Dolby Vision des iPhone récents). Les photos et les autres vidéos fonctionnent toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV non è riuscita a riprodurre questo video. Forse usa un formato che il suo lettore non supporta (spesso HDR o Dolby Vision degli iPhone recenti). Le foto e gli altri video funzionano comunque."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV não conseguiu reproduzir este vídeo. Ele pode usar um formato que o player da TV não aceita (geralmente HDR ou Dolby Vision de iPhones recentes). Fotos e outros vídeos continuam funcionando."
          }
        }
      }
    },
