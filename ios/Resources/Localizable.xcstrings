    },
    "Home belongs to Google TV's setup wizard. Finish the TV's setup, or include the setup wizard in the debloat, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Startbildschirm gehört dem Einrichtungsassistenten von Google TV. Schließe die Einrichtung des Fernsehers ab oder nimm den Assistenten in die Entrümpelung auf und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla de inicio pertenece al asistente de configuración de Google TV. Termina la configuración de la TV o incluye el asistente en la limpieza e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écran d'accueil appartient à l'assistant de configuration de Google TV. Terminez la configuration de la TV ou incluez l'assistant dans le nettoyage, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La schermata Home appartiene alla procedura guidata di Google TV. Completa la configurazione della TV o includi la procedura nella pulizia, poi riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela inicial pertence ao assistente de configuração do Google TV. Termine a configuração da TV ou inclua o assistente na limpeza e tente de novo."
          }
        }
      }
    },
    "Home currently belongs to %@, which isn't a stock launcher this app knows. Nothing was changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Startbildschirm gehört gerade %@, kein vorinstallierter Launcher, den diese App kennt. Nichts wurde geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla de inicio pertenece ahora a %@, que no es un launcher de fábrica que esta app conozca. No se cambió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écran d'accueil appartient actuellement à %@, qui n'est pas un launcher d'origine connu de cette app. Rien n'a été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La schermata Home appartiene ora a %@, che non è un launcher di serie noto a questa app. Non è stato cambiato nulla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela inicial pertence agora a %@, que não é um launcher original conhecido por este app. Nada foi alterado."
          }
        }
      }
    },
    "Home customization connects only while you edit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Startbildschirm-Anpassung verbindet sich nur, während du bearbeitest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personalización de la pantalla de inicio solo se conecta mientras editas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personnalisation de l'accueil ne se connecte que pendant vos modifications."
