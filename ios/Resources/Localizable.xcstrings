        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement le modèle et la version d'Android, aucune donnée personnelle. Les développeurs peuvent aussi ajouter un modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
