    "%@ is on screen. Connecting opens TV Home's editor in the background, which can pause what's playing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auf dem Bildschirm. Beim Verbinden öffnet sich der TV-Home-Editor im Hintergrund, was die Wiedergabe pausieren kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en pantalla. Conectar abre el editor de TV Home en segundo plano, lo que puede pausar lo que se está reproduciendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est à l'écran. La connexion ouvre l'éditeur TV Home en arrière-plan, ce qui peut mettre en pause la lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è sullo schermo. La connessione apre l'editor di TV Home in background e può mettere in pausa ciò che è in riproduzione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está na tela. Conectar abre o editor do TV Home em segundo plano, o que pode pausar o que está passando."
          }
        }
      }
    },
