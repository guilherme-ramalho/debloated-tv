      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This TV can't show photos from Purio. It needs Chromecast built in (most Google TV and Android TV sets have it)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Fernseher kann keine Fotos von Purio zeigen. Dafür braucht er integriertes Chromecast (die meisten Google-TV- und Android-TV-Geräte haben es)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
