    "Core Android or TV middleware: with it disabled the TV may not boot again. This can't be overridden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kernbestandteil von Android oder der TV-Software: Deaktiviert startet der Fernseher eventuell nicht mehr. Das lässt sich nicht übergehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte central de Android o de la TV: si se desactiva, la TV podría no volver a arrancar. No se puede omitir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
