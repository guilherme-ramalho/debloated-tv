    "To show photos and videos on your TV, allow access in Settings › Purio TV › Photos. They're read on this iPhone and sent only to your TV." : {
      "comment" : "Show on TV (photo library on the TV).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To show photos and videos on your TV, allow access in Settings › Purio TV › Photos. They're read on this iPhone and sent only to your TV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Fotos und Videos auf deinem Fernseher zu zeigen, erlaube den Zugriff unter Einstellungen › Purio TV › Fotos. Sie werden auf diesem iPhone gelesen und nur an deinen Fernseher gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar fotos y vídeos en tu tele, permite el acceso en Ajustes › Purio TV › Fotos. Se leen en este iPhone y solo se envían a tu tele."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour afficher vos photos et vidéos sur votre TV, autorisez l'accès dans Réglages › Purio TV › Photos. Elles sont lues sur cet iPhone et envoyées uniquement à votre TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mostrare foto e video sulla TV, consenti l'accesso in Impostazioni › Purio TV › Foto. Vengono letti su questo iPhone e inviati solo alla tua TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar fotos e vídeos na sua TV, permita o acesso em Ajustes › Purio TV › Fotos. Eles são lidos neste iPhone e enviados só para a sua TV."
          }
        }
      }
    },
