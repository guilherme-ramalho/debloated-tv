          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement le modèle et la version d'Android, aucune donnée personnelle. Les développeurs peuvent aussi ajouter un modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo il modello e la versione di Android, nessun dato personale. Anche gli sviluppatori possono aggiungere un modello."
