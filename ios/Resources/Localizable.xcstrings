    "The TV shows “Allow USB debugging?”. Tick “Always allow from this computer” and choose Allow. This continues by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher zeigt „USB-Debugging zulassen?“. Hake „Von diesem Computer immer zulassen“ an und wähle „Zulassen“. Es geht dann von selbst weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV muestra “¿Permitir depuración USB?”. Marca “Permitir siempre desde este ordenador” y elige Permitir. Continúa solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV affiche « Autoriser le débogage USB ? ». Cochez « Toujours autoriser depuis cet ordinateur » et choisissez Autoriser. La suite est automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV mostra “Consentire il debug USB?”. Seleziona “Consenti sempre da questo computer” e scegli Consenti. Poi prosegue da sola."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV mostra “Permitir depuração USB?”. Marque “Sempre permitir neste computador” e escolha Permitir. O resto continua sozinho."
          }
        }
      }
    },
    "The TV shows no code: try again" : {
