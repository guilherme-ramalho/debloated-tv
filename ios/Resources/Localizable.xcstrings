          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV ouvre les Réglages avec elle ; désactivée, les Réglages (et le chemin vers les Options pour les développeurs) ne s'ouvrent plus."
