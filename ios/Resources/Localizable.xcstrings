            "value" : "Puoi riorganizzare tutto in seguito dalla scheda TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dá para reorganizar tudo depois pela aba TV."
          }
        }
