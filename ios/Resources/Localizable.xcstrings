          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe aquí solo la IP, sin puerto. El mando siempre usa los puertos de la propia TV; un puerto como :15555 es solo para Ajustes › Limpieza y nueva pantalla de inicio."
          }
