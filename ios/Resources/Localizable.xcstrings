        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV parou de responder"
          }
        }
      }
    },
    "The TV stopped answering during group %lld. Reconnect and review again; nothing after it was changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher hat bei Gruppe %lld aufgehört zu antworten. Verbinde neu und prüfe erneut; danach wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV dejó de responder durante el grupo %lld. Vuelve a conectar y revisa de nuevo; no se cambió nada después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV a cessé de répondre pendant le groupe %lld. Reconnectez-vous et vérifiez à nouveau ; rien n'a été modifié ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV ha smesso di rispondere durante il gruppo %lld. Ricollegati e rivedi di nuovo; nulla è stato cambiato dopo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV parou de responder no grupo %lld. Reconecte e revise de novo; nada depois dele foi alterado."
          }
        }
      }
    },
    "The TV stopped answering while Home was being switched. The stock Home screen was put back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher hat beim Wechsel des Startbildschirms aufgehört zu antworten. Der ursprüngliche wurde zurückgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV dejó de responder mientras se cambiaba la pantalla de inicio. Se restauró la de fábrica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV a cessé de répondre pendant le changement d'écran d'accueil. L'écran d'origine a été remis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV ha smesso di rispondere durante il cambio della schermata Home. È stata ripristinata quella di serie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV parou de responder durante a troca da tela inicial. A tela inicial original foi restaurada."
          }
        }
      }
    },
    "The TV will ask for confirmation. Nothing is removed until you approve there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher fragt nach einer Bestätigung. Nichts wird entfernt, bevor du dort zustimmst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV pedirá confirmación. No se elimina nada hasta que lo apruebes allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV demandera une confirmation. Rien n'est supprimé avant votre accord sur la TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV chiederà una conferma. Nulla viene rimosso finché non approvi lì."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV vai pedir confirmação. Nada é removido até você aprovar lá."
          }
        }
      }
    },
    "The TV's IP address" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IP-Adresse des Fernsehers"
          }
        },
        "es" : {
