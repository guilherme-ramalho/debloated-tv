    "Add the Debloated TV widget using your iPhone’s widget gallery. Edit the widget to choose its four actions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge das Debloated-TV-Widget über die Widget-Galerie deines iPhone hinzu. Bearbeite es, um seine vier Aktionen zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el widget de Debloated TV desde la galería de widgets del iPhone. Edita el widget para elegir sus cuatro acciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le widget Debloated TV depuis la galerie de widgets de l'iPhone. Modifiez-le pour choisir ses quatre actions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi il widget di Debloated TV dalla galleria widget dell'iPhone. Modificalo per scegliere le sue quattro azioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o widget do Debloated TV pela galeria de widgets do iPhone. Edite o widget para escolher suas quatro ações."
          }
        }
      }
    },
