          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette TV ne peut pas afficher les photos de Purio. Il lui faut Chromecast intégré (la plupart des TV Google TV et Android TV l'ont)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa TV non può mostrare le foto di Purio. Serve Chromecast integrato (ce l'hanno quasi tutte le TV Google TV e Android TV)."
          }
