    "Pair in Debloated TV first. Controls use the existing pairing in the app’s background process; they do not install another TV service. Unlock may be required." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopple zuerst in Debloated TV. Die Steuerungen nutzen die bestehende Kopplung der App; sie installieren keinen weiteren Dienst auf dem Fernseher. Eventuell ist Entsperren nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empareja primero en Debloated TV. Los controles usan el emparejamiento existente de la app; no instalan otro servicio en la TV. Puede que haya que desbloquear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appairez d'abord dans Debloated TV. Les commandes utilisent l'appairage existant de l'app ; elles n'installent aucun autre service sur la TV. Un déverrouillage peut être nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbina prima in Debloated TV. I comandi usano l'abbinamento esistente dell'app; non installano altri servizi sulla TV. Potrebbe servire lo sblocco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pareie primeiro no Debloated TV. Os controles usam o pareamento existente do app; não instalam outro serviço na TV. Pode ser preciso desbloquear."
          }
        }
      }
    },
