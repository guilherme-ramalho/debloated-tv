    "Steps run once in order. A failed step stops the sequence. Actions are cancelled when you leave the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritte laufen einmal der Reihe nach. Ein fehlgeschlagener Schritt stoppt die Abfolge. Aktionen werden abgebrochen, wenn du die App verlässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasos se ejecutan una vez en orden. Un paso fallido detiene la secuencia. Las acciones se cancelan al salir de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes s'exécutent une fois, dans l'ordre. Une étape en échec arrête la séquence. Les actions sont annulées quand vous quittez l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I passaggi vengono eseguiti una volta, in ordine. Un passaggio fallito interrompe la sequenza. Le azioni si annullano quando esci dall'app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As etapas rodam uma vez, em ordem. Uma etapa com falha interrompe a sequência. As ações são canceladas quando você sai do app."
          }
        }
      }
    },
