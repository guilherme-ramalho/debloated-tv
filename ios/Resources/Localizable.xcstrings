    "%lld apps stayed enabled because the TV refused: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Apps blieben aktiv, weil der Fernseher ablehnte: %@."
