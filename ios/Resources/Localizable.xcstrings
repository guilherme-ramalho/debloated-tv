    "Works with Android TV and Google TV. Next, your TV shows a 6-character code to confirm it's you." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert mit Android TV und Google TV. Danach zeigt dein Fernseher einen 6-stelligen Code, um zu bestätigen, dass du es bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con Android TV y Google TV. Después, tu TV muestra un código de 6 caracteres para confirmar que eres tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne avec Android TV et Google TV. Ensuite, votre TV affiche un code de 6 caractères pour confirmer que c'est vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona con Android TV e Google TV. Poi la TV mostra un codice di 6 caratteri per confermare che sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona com Android TV e Google TV. Em seguida, a TV mostra um código de 6 caracteres para confirmar que é você."
          }
        }
      }
    },
