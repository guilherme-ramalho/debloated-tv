          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta TV se identifica como %@ (%@). Estas listas vêm do cleanyourtv, cada uma testada pela comunidade na TV que ela cita. A mais compatível vem primeiro."
          }
        }
      }
    },
