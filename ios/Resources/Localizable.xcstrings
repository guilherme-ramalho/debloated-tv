    "At the end the TV restarts once, so this phone can check that Home and your changes hold before debugging goes off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Ende startet der Fernseher einmal neu, damit dieses Telefon prüfen kann, ob der Startbildschirm und deine Änderungen bestehen bleiben, bevor das Debugging ausgeschaltet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al final la TV se reinicia una vez, para que este teléfono compruebe que la pantalla de inicio y tus cambios se mantienen antes de desactivar la depuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la fin, la TV redémarre une fois, pour que ce téléphone vérifie que l'écran d'accueil et vos changements tiennent avant de couper le débogage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla fine la TV si riavvia una volta, così questo telefono può verificare che la schermata Home e le tue modifiche reggano prima di disattivare il debug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No fim a TV reinicia uma vez, para este telefone verificar que a tela inicial e suas alterações se mantêm antes de desligar a depuração."
          }
        }
      }
    },
