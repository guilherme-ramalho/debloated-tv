        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone n'a pas configuré l'écran d'accueil de cette TV, il ne peut donc pas le mettre à jour d'ici. Rien n'a été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
