    "Core Android or TV middleware: with it disabled the TV may not boot again. This can't be overridden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kernbestandteil von Android oder der TV-Software: Deaktiviert startet der Fernseher eventuell nicht mehr. Das lässt sich nicht übergehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte central de Android o de la TV: si se desactiva, la TV podría no volver a arrancar. No se puede omitir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Composant central d'Android ou de la TV : désactivé, la TV pourrait ne plus démarrer. Impossible de passer outre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Componente essenziale di Android o della TV: se disattivato, la TV potrebbe non avviarsi più. Non è possibile ignorarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte central do Android ou da TV: desativado, a TV pode não ligar de novo. Isso não pode ser ignorado."
          }
        }
      }
    },
    "Could not connect to the paired TV. Check Wi-Fi, TV power, and Local Network access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Verbindung zum gekoppelten Fernseher. Prüfe WLAN, ob der Fernseher an ist, und den Zugriff auf das lokale Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar a la TV emparejada. Revisa el Wi-Fi, que la TV esté encendida y el acceso a la red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se connecter à la TV appairée. Vérifiez le Wi-Fi, que la TV est allumée et l'accès au réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile collegarsi alla TV abbinata. Controlla il Wi-Fi, che la TV sia accesa e l'accesso alla rete locale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar à TV pareada. Verifique o Wi-Fi, se a TV está ligada e o acesso à Rede Local."
          }
        }
      }
    },
