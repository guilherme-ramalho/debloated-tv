    "Keep switched on = stays enabled. 1 protected system app is never touched. %lld listed apps are already off or not installed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingeschaltet = bleibt aktiv. 1 geschützte System-App wird nie angerührt. %lld gelistete Apps sind schon aus oder nicht installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado = sigue activa. 1 app del sistema protegida nunca se toca. %lld apps de la lista ya están desactivadas o no instaladas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé = reste actif. 1 app système protégée n’est jamais touchée. %lld apps de la liste sont déjà désactivées ou absentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivo = resta attiva. 1 app di sistema protetta non viene mai toccata. %lld app dell'elenco sono già spente o non installate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligado = continua ativo. 1 app de sistema protegido nunca é tocado. %lld apps da lista já estão desativados ou não instalados."
          }
        }
      }
    },
