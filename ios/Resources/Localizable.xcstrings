        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste de cleanyourtv, testée par sa communauté sur ce modèle, pas par Purio TV. Activez ce que vous voulez garder ; le reste est désactivé."
