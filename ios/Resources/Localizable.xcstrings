        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'existe pas de liste testée pour ce modèle, l'app ne devinera donc pas quelles apps désactiver sans risque. La télécommande et les actions fonctionnent normalement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'è un elenco testato per questo modello, quindi l'app non indovinerà quali app è sicuro disattivare. Telecomando e azioni funzionano come sempre."
