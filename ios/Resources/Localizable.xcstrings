    "Open network: no password needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offenes Netzwerk: kein Passwort nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Red abierta: no hace falta contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réseau ouvert : aucun mot de passe nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
