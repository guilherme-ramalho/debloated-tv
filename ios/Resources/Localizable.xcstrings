{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "%@" : {

    },
    "%@ is asking whether to allow this iPhone. Choose Allow (or Accept) with the TV's own remote." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fragt, ob dieses iPhone erlaubt werden soll. Wähle „Zulassen“ (oder „Akzeptieren“) mit der Fernbedienung des Fernsehers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pregunta si permite este iPhone. Elige Permitir (o Aceptar) con el mando de la TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande s'il faut autoriser cet iPhone. Choisissez Autoriser (ou Accepter) avec la télécommande de la TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chiede se consentire questo iPhone. Scegli Consenti (o Accetta) con il telecomando della TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está perguntando se permite este iPhone. Escolha Permitir (ou Aceitar) com o controle da TV."
          }
        }
      }
    },
    "%@ isn't on this TV." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht auf diesem Fernseher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está en esta TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas sur cette TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è su questa TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está nesta TV."
          }
        }
      }
    },
    "%@ · %@ · %lld apps to turn back on" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ · %lld Apps zum Wiedereinschalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ · %3$lld apps to turn back on"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ · %lld apps para reactivar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ · %lld apps à réactiver"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ · %lld app da riattivare"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ · %lld apps para reativar"
          }
        }
      }
    },
    "%@ didn't answer." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat nicht geantwortet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas répondu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha risposto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não respondeu."
          }
        }
      }
    },
    "%@ is on screen. Connecting opens TV Home's editor in the background, which can pause what's playing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auf dem Bildschirm. Beim Verbinden öffnet sich der TV-Home-Editor im Hintergrund, was die Wiedergabe pausieren kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en pantalla. Conectar abre el editor de TV Home en segundo plano, lo que puede pausar lo que se está reproduciendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est à l'écran. La connexion ouvre l'éditeur TV Home en arrière-plan, ce qui peut mettre en pause la lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è sullo schermo. La connessione apre l'editor di TV Home in background e può mettere in pausa ciò che è in riproduzione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está na tela. Conectar abre o editor do TV Home em segundo plano, o que pode pausar o que está passando."
          }
        }
      }
    },
    "%@ is showing a 6-character code." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zeigt einen 6-stelligen Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muestra un código de 6 caracteres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ affiche un code de 6 caractères."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mostra un codice di 6 caratteri."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está mostrando um código de 6 caracteres."
          }
        }
      }
    },
