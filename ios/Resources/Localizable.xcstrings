    "The password goes to the TV once, over the debugging connection, which isn't encrypted. It's never saved on this phone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort geht einmal über die Debugging-Verbindung an den Fernseher, die nicht verschlüsselt ist. Auf diesem Telefon wird es nie gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña se envía una vez a la TV por la conexión de depuración, que no está cifrada. Nunca se guarda en este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe est envoyé une fois à la TV par la connexion de débogage, qui n'est pas chiffrée. Il n'est jamais enregistré sur ce téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password viene inviata una volta alla TV tramite la connessione di debug, che non è cifrata. Non viene mai salvata su questo telefono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha vai uma vez para a TV pela conexão de depuração, que não é criptografada. Ela nunca é salva neste telefone."
          }
        }
      }
    },
