    "On the TV, choose “Always allow” and Allow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle am Fernseher „Immer zulassen“ und „Zulassen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la TV, elige “Permitir siempre” y Permitir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur la TV, choisissez « Toujours autoriser » puis Autoriser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla TV, scegli “Consenti sempre” e Consenti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na TV, escolha “Sempre permitir” e Permitir."
          }
        }
      }
    },
    "On the TV: Settings › Network & Internet › your Wi-Fi or Ethernet connection › IP address. It looks like 192.168.1.20." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Fernseher: Einstellungen › Netzwerk und Internet › deine WLAN- oder Ethernet-Verbindung › IP-Adresse. Sie sieht aus wie 192.168.1.20."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la TV: Ajustes › Red e Internet › tu conexión Wi-Fi o Ethernet › Dirección IP. Se parece a 192.168.1.20."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur la TV : Réglages › Réseau et Internet › votre connexion Wi-Fi ou Ethernet › Adresse IP. Elle ressemble à 192.168.1.20."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla TV: Impostazioni › Rete e Internet › la tua connessione Wi-Fi o Ethernet › Indirizzo IP. Ha un aspetto come 192.168.1.20."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na TV: Ajustes › Rede e Internet › sua conexão Wi-Fi ou cabeada › Endereço IP. Parece com 192.168.1.20."
          }
        }
      }
    },
    "Only needed if the TV has forgotten this phone or its pairing was reset. An offline TV does not normally need re-pairing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur nötig, wenn der Fernseher dieses Telefon vergessen hat oder die Kopplung zurückgesetzt wurde. Ein Fernseher offline muss normalerweise nicht neu gekoppelt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo hace falta si la TV ha olvidado este teléfono o se restableció el emparejamiento. Una TV sin conexión normalmente no necesita volver a emparejarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire seulement si la TV a oublié ce téléphone ou si l'appairage a été réinitialisé. Une TV hors ligne n'a normalement pas besoin d'être réappairée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve solo se la TV ha dimenticato questo telefono o l'abbinamento è stato reimpostato. Una TV offline di solito non va riabbinata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só é necessário se a TV esqueceu este celular ou o pareamento foi redefinido. Uma TV offline normalmente não precisa de novo pareamento."
          }
        }
      }
    },
    "Only the model and Android version, no personal data. Developers can add a model too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Modell und Android-Version, keine persönlichen Daten. Entwickler können ein Modell auch selbst hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo el modelo y la versión de Android, sin datos personales. Los desarrolladores también pueden añadir un modelo."
