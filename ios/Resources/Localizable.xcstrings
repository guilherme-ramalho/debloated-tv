    "First focus a search or password field on the TV. Text is sent over the paired encrypted connection and is never saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle zuerst ein Such- oder Passwortfeld am Fernseher. Der Text geht über die verschlüsselte gekoppelte Verbindung und wird nie gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero selecciona un campo de búsqueda o contraseña en la TV. El texto se envía por la conexión cifrada emparejada y nunca se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez d'abord un champ de recherche ou de mot de passe sur la TV. Le texte passe par la connexion chiffrée appairée et n'est jamais enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona prima un campo di ricerca o password sulla TV. Il testo passa dalla connessione cifrata abbinata e non viene mai salvato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro selecione um campo de busca ou senha na TV. O texto vai pela conexão criptografada pareada e nunca é salvo."
          }
        }
      }
    },
