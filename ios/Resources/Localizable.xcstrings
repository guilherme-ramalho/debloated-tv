          }
        }
      }
    },
    "Ask in your own words: “open Netflix”, “a bit quieter”. Runs on this iPhone with Apple Intelligence; nothing is sent anywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag in deinen eigenen Worten: „Öffne Netflix“, „etwas leiser“. Läuft auf diesem iPhone mit Apple Intelligence; nichts wird irgendwohin gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide con tus palabras: «abre Netflix», «un poco más bajo». Funciona en este iPhone con Apple Intelligence; no se envía nada a ninguna parte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez avec vos mots : « ouvre Netflix », « un peu moins fort ». Fonctionne sur cet iPhone avec Apple Intelligence ; rien n'est envoyé nulle part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi con parole tue: «apri Netflix», «un po' più basso». Funziona su questo iPhone con Apple Intelligence; non viene inviato nulla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça com suas palavras: “abra a Netflix”, “um pouco mais baixo”. Funciona neste iPhone com a Apple Intelligence; nada é enviado a lugar nenhum."
          }
        }
      }
    },
