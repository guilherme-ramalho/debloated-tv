        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld apps stayed enabled because the TV refused: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld apps siguieron activas porque la TV se negó: %@."
